{
  "name": "@justdeploy/sdk",
  "version": "0.2.1",
  "description": "Official server-side JavaScript and TypeScript SDK for JustDeploy",
  "license": "Apache-2.0",
  "author": "CUPPASOFT LTD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuppasoft/justdeploy-sdk.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/cuppasoft/justdeploy-sdk#readme",
  "bugs": {
    "url": "https://github.com/cuppasoft/justdeploy-sdk/issues"
  },
  "keywords": [
    "justdeploy",
    "database",
    "storage",
    "mail"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "browser": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finish-build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && npm run test:types && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
